#!/usr/bin/env bash
# FCP launcher: project venv + bundled OSS CAD Suite; works from any directory
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$HERE/.tools/oss-cad-suite/bin:$PATH"
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$HERE/.venv/bin/python" -m fcp.cli "$@"
